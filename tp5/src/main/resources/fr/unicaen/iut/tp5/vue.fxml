<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.unicaen.iut.tp5.ControlerDemineur">
   <top>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Jeu">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Quitter" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Difficulté">
                     <items>
                        <RadioMenuItem mnemonicParsing="false" text="Facile" userData="10;10;10">
                           <toggleGroup>
                              <ToggleGroup fx:id="difficulty" />
                           </toggleGroup>
                        </RadioMenuItem>
                        <RadioMenuItem mnemonicParsing="false" text="Moyen" toggleGroup="$difficulty" userData="20;20;50" />
                        <RadioMenuItem mnemonicParsing="false" text="Difficile" toggleGroup="$difficulty" userData="30;20;100" />
                     </items>
                </Menu>
              </menus>
            </MenuBar>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Nombre d'inconnu :" />
                  <TextField fx:id="inconnuInput" editable="false" focusTraversable="false" />
                  <Label text="Nombre de marques :" />
                  <TextField fx:id="marquesInput" editable="false" focusTraversable="false" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <GridPane fx:id="grid" gridLinesVisible="true" BorderPane.alignment="CENTER">
      </GridPane>
   </center>
</BorderPane>
